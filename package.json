{
  "name": "realtime-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "dev": "pnpm --filter @realtime-agent/home run dev",
    "dev:cloudflare": "pnpm --filter @realtime-agent/home run dev:cloudflare",
    "dev:home": "pnpm --filter @realtime-agent/home run dev",
    "dev:demo": "pnpm --filter @realtime-agent/demo run dev",
    "dev:computer": "pnpm --filter @realtime-agent/computer run dev",
    "dev:computer:live": "pnpm --filter @realtime-agent/computer run dev:live",
    "check:computer": "pnpm --filter @realtime-agent/computer run check:config",
    "computer": "node scripts/computer.mjs",
    "test:computer:live": "pnpm --filter @realtime-agent/computer run test:live:task",
    "dev:computer:manual": "pnpm --filter @realtime-agent/computer run dev:manual",
    "test:computer": "pnpm --filter @realtime-agent/computer run test:cua",
    "test:computer:browser-fixture": "pnpm --filter @realtime-agent/computer run test:e2e",
    "dev:all": "pnpm --parallel --filter './apps/*' run dev",
    "start": "pnpm --filter @realtime-agent/home run start",
    "start:demo": "pnpm --filter @realtime-agent/demo run start",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:e2e": "pnpm -r --workspace-concurrency=1 run test:e2e",
    "test:live": "pnpm --filter @realtime-agent/home run test:live",
    "test:native": "pnpm --filter @realtime-agent/home run test:native",
    "test:livekit": "pnpm --filter @realtime-agent/home run test:livekit",
    "test:cloudflare": "pnpm --filter @realtime-agent/home run test:cloudflare",
    "test:voice-api": "pnpm --filter @realtime-agent/home run test:voice-api",
    "test:agent-package": "node scripts/verify-agent-package.mjs",
    "test:agent-live": "pnpm --filter @realtime-agent/home run test:agent-live",
    "test:controlled-live": "pnpm --filter @realtime-agent/home run test:controlled-live",
    "voice:infra:up": "node scripts/livekit-infra.mjs up",
    "voice:infra:down": "node scripts/livekit-infra.mjs down"
  }
}
