# Copy this file to .env at the workspace root and fill in your own keys.
# With a System One key, the app defaults to live mode. Without one it uses demo mode.
# Set AGENT_MODE=demo explicitly to run offline even when keys are configured.

SYSTEM_ONE_BASE_URL=https://api.typesafe.ai/v1
SYSTEM_ONE_MODEL=jev-latest
SYSTEM_ONE_API_KEY=

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Native realtime audio. Start with OpenAI direct WebRTC: only one extra key is required.
# Never reuse a DeepSeek or System One key as another provider's key.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional model overrides. Defaults verified against official documentation on 2026-09-18.
VOICE_OPENAI_MODEL=gpt-realtime-2.1
VOICE_GEMINI_MODEL=gemini-3.8-live
VOICE_XAI_MODEL=grok-voice-think-fast-2.0
# GPT-Live requires alpha access. Backend reasoning/tools have separate model usage.
VOICE_DUPLEX_MODEL=gpt-live-1
VOICE_DUPLEX_BACKEND_MODEL=gpt-5.6-luna

# Required only for LiveKit profiles. Use cloud credentials, or run `pnpm voice:infra:up`.
# Local loopback development: URL=ws://127.0.0.1:7880, API_KEY=devkey, API_SECRET=secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
