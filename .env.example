# Recommended: fill these two fields, then run pnpm dev:cloudflare.
# One account token covers Jev, text chat and native Grok voice.
# Token permission: Account > Workers AI > Read. Load AI Gateway credits first.
# Use an API Token, NOT a Global API Key. Do not overwrite an existing .env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Auto-selected when either field is present; dev:cloudflare forces this mode.
# AI_PROVIDER=cloudflare
# Optional supported third-party text model (Cloudflare author/model name):
# CLOUDFLARE_LLM_MODEL=openai/gpt-4.1-mini
# AGENT_MODE=demo # explicit offline demo, no model calls

# Optional legacy direct mode. Cloudflare mode ignores these vendor credentials.
# AI_PROVIDER=direct
# SYSTEM_ONE_BASE_URL=https://api.typesafe.ai/v1
# SYSTEM_ONE_MODEL=jev-latest
# SYSTEM_ONE_API_KEY=

# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=

# Direct native audio is optional; not needed for Cloudflare mode.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=

# Optional model overrides. Defaults verified against official documentation on 2026-09-18.
# VOICE_OPENAI_MODEL=gpt-realtime-2.1
# VOICE_GEMINI_MODEL=gemini-3.8-live
# VOICE_XAI_MODEL=grok-voice-think-fast-2.0
# GPT-Live requires alpha access. Backend reasoning/tools have separate model usage.
# VOICE_DUPLEX_MODEL=gpt-live-1
# VOICE_DUPLEX_BACKEND_MODEL=gpt-5.6-luna

# Cloudflare mode defaults to the local room. Leave all three unset for auto defaults.
# Only uncomment these to use a separately configured LiveKit server.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
