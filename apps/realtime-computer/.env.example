# Copy to the repository root .env OR this application's .env; keep existing credentials.
# Direct mode: set the actual System One key plus a matching LLM endpoint/model/key.
AI_PROVIDER=direct
SYSTEM_ONE_BASE_URL=https://api.typesafe.ai/v1
SYSTEM_ONE_MODEL=jev-latest
SYSTEM_ONE_API_KEY=

# Empty LLM_BASE_URL uses the loader's default https://api.openai.com/v1.
# For another service, replace it with that service's actual API base URL.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# auto: send screenshots to a vision-capable LLM; if it rejects image input,
# retry once with accessibility data and display that limitation in the UI.
# 1: require screenshots (no text-only fallback). 0: accessibility data only.
COMPUTER_VISION=auto

# Alternative: replace AI_PROVIDER above with cloudflare and fill both fields below.
# In Cloudflare mode the shared loader supplies both model roles from this account.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_LLM_MODEL=your-enabled-author/model

# Check without reading the screen, sending input or calling a model:
# pnpm check:computer
